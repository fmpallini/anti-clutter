#!/bin/sh
# Atualiza "Version" e "Last modified" do filtro sempre que ele for commitado.
f=filter/anticlutter.txt

git diff --cached --name-only | grep -qx "$f" || exit 0

if ! git diff --quiet -- "$f"; then
  echo "pre-commit: $f tem alterações não staged; faça 'git add $f' ou descarte-as." >&2
  exit 1
fi

# Valida a sintaxe para uBO, AdGuard e ABP (aglint.config.json). Pula se as ferramentas não estiverem instaladas.
aglint=tools/node_modules/.bin/aglint
if [ -x "$aglint" ]; then
  "$aglint" "$f" || { echo "pre-commit: AGLint encontrou problemas em $f." >&2; exit 1; }
else
  echo "pre-commit: AGLint não instalado (cd tools && npm install); lint pulado." >&2
fi

v=$(LC_ALL=C date -u +%Y.%m.%d.%H%M)
m=$(LC_ALL=C date -u '+%d %b %Y %H:%M UTC')
sed -i -e "s/^! Version:[^\r]*/! Version: $v/" \
       -e "s/^! Last modified:[^\r]*/! Last modified: $m/" "$f"
git add "$f"
